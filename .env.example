TRUSTFLOW_MODE=fixture
TRUSTFLOW_DB_PATH=./trustflow.db

# SerpApi — live web evidence
SERPAPI_API_KEY=

# Nutrient DWS Data Extraction API
NUTRIENT_API_KEY=
NUTRIENT_EXTRACT_URL=https://api.nutrient.io/extraction/extract

# Optional Gemini evidence synthesizer. Deterministic policy, not Gemini, controls signing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Xano — configure endpoints created in your challenge workspace.
XANO_WORKFLOW_UPSERT_URL=
XANO_AUDIT_EVENT_URL=
XANO_API_TOKEN=

# Doctavian — exact generation endpoint/header comes from sponsor quickstart credentials.
DOCTAVIAN_GENERATE_URL=
DOCTAVIAN_API_KEY=
DOCTAVIAN_AUTH_HEADER=Authorization
DOCTAVIAN_AUTH_PREFIX=Bearer
DOCTAVIAN_TEMPLATE_ID=

# Foxit eSign — official unified gateway quickstart.
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_ESIGN_CREATE_URL=https://na1.fusion.foxit.com/esign/api/v1/folders/createfolder
